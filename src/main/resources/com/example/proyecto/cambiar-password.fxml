<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" style="-fx-padding: 24; -fx-min-width: 380;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.proyecto.controller.CambiarPasswordController">

    <Label text="Cambiar contraseña"
           style="-fx-font-size: 16; -fx-font-weight: bold;"/>

    <Separator/>

    <GridPane hgap="12" vgap="10">

        <Label text="Nueva contraseña:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <StackPane GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="240">
            <PasswordField fx:id="txtNueva" prefWidth="240"/>
            <TextField fx:id="txtNuevaVisible" prefWidth="240" visible="false" managed="false"/>
            <Button fx:id="btnOjoNueva" text="👁"
                    onAction="#toggleNueva"
                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 13; -fx-padding: 0 8 0 0; -fx-text-fill: #9ca3af;"
                    StackPane.alignment="CENTER_RIGHT"/>
        </StackPane>

        <Label text="Confirmar contraseña:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <StackPane GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="240">
            <PasswordField fx:id="txtConfirmar" prefWidth="240"/>
            <TextField fx:id="txtConfirmarVisible" prefWidth="240" visible="false" managed="false"/>
            <Button fx:id="btnOjoConfirmar" text="👁"
                    onAction="#toggleConfirmar"
                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 13; -fx-padding: 0 8 0 0; -fx-text-fill: #9ca3af;"
                    StackPane.alignment="CENTER_RIGHT"/>
        </StackPane>

    </GridPane>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Guardar" onAction="#guardar"/>
        <Button text="Cancelar" onAction="#cancelar"/>
    </HBox>

</VBox>