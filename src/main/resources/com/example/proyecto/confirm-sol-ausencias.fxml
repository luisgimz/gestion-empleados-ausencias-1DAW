<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.proyecto.controller.ConfirmSolAusenciasController"
      spacing="15"
      style="-fx-padding: 25;">

    <Label text="Confirmar solicitud"
           style="-fx-font-size: 18; -fx-font-weight: bold;"/>
    <Separator/>

    <Label fx:id="lblMensajePrincipal"
           wrapText="true" prefWidth="350"
           style="-fx-font-size: 12;"/>

    <Label fx:id="lblMensajeSecundario"
           wrapText="true" prefWidth="350"
           style="-fx-font-size: 12;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button text="Volver" fx:id="btnVolver" onAction="#volverFormulario"
                prefWidth="90" prefHeight="30" style="-fx-font-size: 12;"/>
        <Button text="Aceptar" fx:id="btnAceptar" onAction="#aceptarSolicitud"
                prefWidth="90" prefHeight="30" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    </HBox>

</VBox>