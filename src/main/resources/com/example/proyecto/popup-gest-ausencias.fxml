<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="12"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.proyecto.controller.PopUpGestAusenciasController">
    <padding><Insets top="30" bottom="30" left="40" right="40"/></padding>

    <Label text="Solicitud Ausencia" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Separator/>

    <GridPane hgap="15" vgap="10">
        <Label text="Nombre:"           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="lblNombre"        GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Tipo de ausencia:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="lblTipo"          GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Duración:"         GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="lblDuracion"      GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Motivo:"           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label fx:id="lblMotivo"        GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Fecha solicitud:"  GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Label fx:id="lblFechaSol"      GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Estado:"           GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <Label fx:id="lblEstado"        GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Comentario:"       GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextArea fx:id="txtComentario" GridPane.columnIndex="1" GridPane.rowIndex="6"
                  prefWidth="200" prefHeight="50" wrapText="true"
                  promptText="Añade un comentario..."
                  style="-fx-font-size: 12;"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Aceptar"  fx:id="btnAceptar"  onAction="#handleAceptar"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="Rechazar" fx:id="btnRechazar" onAction="#handleRechazar"/>
    </HBox>

</VBox>