<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" style="-fx-padding: 20;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.proyecto.controller.RegAusenciasController"
      VBox.vgrow="ALWAYS">

    <Label text="Registro Ausencias APROBADAS/RECHAZADAS"
           style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Filtrar por:"/>
        <ComboBox fx:id="cmbFiltroTipo"
                  promptText="Selecciona..."
                  prefWidth="180"
                  onAction="#onFiltroTipoChanged"/>
        <TextField fx:id="txtFiltro"
                   promptText="Escribe aquí..."
                   prefWidth="200"/>
        <DatePicker fx:id="dpFiltro"
                    prefWidth="200"
                    visible="false"
                    managed="false"/>
        <Button text="Filtrar"  onAction="#aplicarFiltro"/>
        <Button text="Limpiar"  onAction="#limpiarFiltro"/>
    </HBox>

    <TableView fx:id="tablaRegistros" VBox.vgrow="ALWAYS"> <!-- grows to fill remaining space -->
        <columns>
            <TableColumn fx:id="colId"       text="ID"             prefWidth="50"/>
            <TableColumn fx:id="colIdSol"    text="ID Solicitud"   prefWidth="90"/>
            <TableColumn fx:id="colTipoSol"  text="Tipo Ausencia"  prefWidth="130"/>
            <TableColumn fx:id="colNomEmp"   text="Empleado"       prefWidth="160"/>
            <TableColumn fx:id="colNomAdmin" text="Administrador/Moderador"  prefWidth="160"/>
            <TableColumn fx:id="colFechaReg" text="Fecha Registro" prefWidth="140"/>
            <TableColumn fx:id="colEstadoSol" text="Estado Solicitud" prefWidth="140"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Ver Detalles" onAction="#verDetalles"/>
    </HBox>

</VBox>