<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.proyecto.controller.DetalleAusenciaPendienteController"
      spacing="12" prefWidth="420">
    <padding><Insets top="30" bottom="30" left="40" right="40"/></padding>

    <Label text="Detalles Ausencia" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Separator/>

    <GridPane hgap="20" vgap="10">
        <Label text="Nombre:"           GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblNombre"        GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Tipo de ausencia:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblTipo"          GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Duración:"         GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblDuracion"      GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Motivo:"           GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblMotivo"        GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Fecha solicitud:"  GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblFechaSolicitud" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Estado:"           GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblEstado"        GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button text="Eliminar solicitud" onAction="#handleEliminar"/>
        <Button text="Cerrar" onAction="#handleCerrar"/>
    </HBox>
</VBox>